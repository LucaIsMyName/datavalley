DATABASE_URL=postgres://localhost:5432/datavalley
# Embedded Postgres for local development when PostgreSQL is not installed.
# Do not use this in production.
# DATABASE_URL=pglite:./data/pglite

SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
CSRF_SECRET=change-me-to-a-different-random-string-32
CREDENTIALS_KEY=change-me-to-a-random-string-at-least-32-chars

WEB_ORIGIN=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
NODE_ENV=development
TRUST_PROXY=false

MEDIA_ROOT=./data/media
MEDIA_MAX_BYTES=10485760

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-please

REDIS_URL=redis://127.0.0.1:6379
IMPORT_SYNC_LIMIT=5000
EXPORT_SYNC_LIMIT=5000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google-sheets/callback

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

STATEMENT_TIMEOUT_MS=5000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
LOGIN_RATE_LIMIT_MAX=30
