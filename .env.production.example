# Copy this file to a local name such as .env.lucaProd or .env.customer1.
# npm run deploy lists those files and installs the one you choose.
# This example is committed. The copy you fill in stays on your machine.

# SSH into the Ubuntu VPS. The user can be root or another account that can sudo.
SSH_HOST=
SSH_USER=root
SSH_PORT=22
SSH_KEY_PATH=/absolute/path/to/id_ed25519
DOMAIN=crm.example.com
DEPLOY_PATH=/opt/datavalley
APP_USER=datavalley

DATABASE_URL=postgres://datavalley:change-me-db-password@127.0.0.1:5432/datavalley
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
CSRF_SECRET=change-me-to-a-different-random-string-32
CREDENTIALS_KEY=change-me-to-a-random-string-at-least-32-chars

WEB_ORIGIN=https://crm.example.com
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
NODE_ENV=production
TRUST_PROXY=true

MEDIA_ROOT=./data/media
MEDIA_MAX_BYTES=10485760

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-please-12

REDIS_URL=redis://127.0.0.1:6379
IMPORT_SYNC_LIMIT=5000
EXPORT_SYNC_LIMIT=5000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASSWORD=change-me-smtp-password
SMTP_FROM=Datavalley <mailer@example.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crm.example.com/api/v1/integrations/google-sheets/callback

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

STATEMENT_TIMEOUT_MS=5000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
LOGIN_RATE_LIMIT_MAX=30
